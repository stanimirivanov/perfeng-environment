	bind 127.0.0.1
	tls internal
	reverse_proxy 127.0.0.1:18333 {
		header_up Host {http.request.hostport}
	}
}

https://127.0.0.1:10443 {
	bind 127.0.0.1
	tls internal
	reverse_proxy 127.0.0.1:18081 {
		header_up Host {http.request.hostport}
	}
}
