{
	admin off
	persist_config off
	auto_https disable_redirects
	skip_install_trust
	storage file_system {
		root .local/native-gateway/caddy-data
	}
	log {
		output discard
	}
	servers {
		protocols h1 h2
	}
}

https://127.0.0.1:8443 {
	bind 127.0.0.1
	tls internal
	reverse_proxy 127.0.0.1:18080 {
		header_up Host {http.request.hostport}
	}
}

